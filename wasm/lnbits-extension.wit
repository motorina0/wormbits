package lnbits:extension;

interface host {
  record storage-get-request {
    table: string,
    id: string
  }

  record storage-get-response {
    data-json: option<string>
  }

  record storage-set-request {
    table: string,
    data-json: string
  }

  record storage-set-response {
    ok: bool
  }

  record storage-paginated-request {
    table: string,
    filters-json: string,
    search: string,
    search-fields: list<string>,
    sort-by: string,
    descending: bool,
    limit: u32,
    offset: u32
  }

  record storage-paginated-response {
    rows-json: string,
    total: u64
  }

  record storage-delete-request {
    table: string,
    id: string
  }

  record storage-delete-response {
    ok: bool
  }

  record websocket-publish-request {
    item-id: string,
    data-json: string
  }

  record websocket-publish-response {
    sent: bool
  }

  record random-id-request {
    prefix: string
  }

  record random-id-response {
    id: string
  }

  record now-response {
    timestamp: u64
  }

  record log-request {
    level: string,
    message: string
  }

  record log-response {
    ok: bool
  }

  storage-get: func(request: storage-get-request) -> storage-get-response;
  storage-set: func(request: storage-set-request) -> storage-set-response;
  storage-get-paginated: func(request: storage-paginated-request) -> storage-paginated-response;
  storage-delete: func(request: storage-delete-request) -> storage-delete-response;
  websocket-publish: func(request: websocket-publish-request) -> websocket-publish-response;
  random-id: func(request: random-id-request) -> random-id-response;
  now: func() -> now-response;
  log: func(request: log-request) -> log-response;
}

world wormbits {
  import host;

  export create-wormbits-room: func(request-json: string) -> string;
  export get-wormbits-room: func(request-json: string) -> string;
  export join-wormbits-room: func(request-json: string) -> string;
  export spectate-wormbits-room: func(request-json: string) -> string;
  export set-wormbits-ready: func(request-json: string) -> string;
  export start-wormbits-match: func(request-json: string) -> string;
  export submit-wormbits-action: func(request-json: string) -> string;
  export heartbeat-wormbits-room: func(request-json: string) -> string;
  export forfeit-wormbits-match: func(request-json: string) -> string;
}
